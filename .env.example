# Local Docker Compose configuration. Copy to .env and supply your own values.
FRIOTRACK_POSTGRES_PASSWORD=
FRIOTRACK_POSTGRES_PORT=5433
FRIOTRACK_HTTP_PORT=5180
FRIOTRACK_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional demonstration accounts for an empty local database only.
# Both passwords must have at least 12 characters when seeding is enabled.
FRIOTRACK_SEED=false
FRIOTRACK_COORDINATOR_PASSWORD=
FRIOTRACK_CLIENT_PASSWORD=
