<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.4.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);output/**;tmp/**;data/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Content Update="seed.json" CopyToOutputDirectory="PreserveNewest" /><Content Include="Resources/Fonts/*.ttf;Resources/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="PDFsharp" Version="6.2.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
